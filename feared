local function GetAllConfigs()
    local configs = {}
    local files = listfiles(ConfigsFolder)
    
    for _, file in pairs(files) do
        local fileName = file:match("^.+/(.+)$") or file:match("^.+\\(.+)$")
        if fileName and fileName:match("%.json$") then
            local configName = fileName:gsub("%.json$", "")
            table.insert(configs, configName)
        end
    end
    
    if #configs == 0 then
        table.insert(configs, "No configs found")
    end
    
    return configs
end

