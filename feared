            if targetPart then
                local predictedPos = GetPredictedPosition(targetPart, SilentAim.Prediction)
                
                if predictedPos then
                    return CFrame.new(predictedPos)
                end
            end
        end
    end
    
    return backupindex(self, v)
end)

