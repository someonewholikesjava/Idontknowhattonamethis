local function ServerHopLowPing()
    local Api = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
    
    local function FetchServers(cursor)
        local success, result = pcall(function()
            local url = Api .. ((cursor and "&cursor="..cursor) or "")
            local response = game:HttpGet(url)
            return HttpService:JSONDecode(response)
        end)
        return success and result or nil
    end
    
    local serversWithPing = {}
    local serversWithoutPing = {}
    local cursor = nil
    local pageCount = 0
    
    repeat
        local data = FetchServers(cursor)
        if not data or not data.data then break end
        
        for _, server in pairs(data.data) do
            if server.id ~= game.JobId and server.playing < server.maxPlayers then
                if server.ping and tonumber(server.ping) then
                    table.insert(serversWithPing, server)
                else
                    table.insert(serversWithoutPing, server)
                end
            end
        end
        
        cursor = data.nextPageCursor
        pageCount = pageCount + 1
    until not cursor or pageCount >= 3
    
    if #serversWithPing > 0 then
        table.sort(serversWithPing, function(a, b)
            return tonumber(a.ping) < tonumber(b.ping)
        end)
        
        local bestServer = serversWithPing[1]
        TeleportService:TeleportToPlaceInstance(game.PlaceId, bestServer.id, LocalPlayer)
    elseif #serversWithoutPing > 0 then
        local randomServer = serversWithoutPing[math.random(1, #serversWithoutPing)]
        TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServer.id, LocalPlayer)
    end
end

local function ServerHopRandom()
    local Api = "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Asc&limit=100"
    local function ListServers(cursor)
        local success, result = pcall(function()
            return HttpService:JSONDecode(game:HttpGet(Api .. ((cursor and "&cursor="..cursor) or "")))
        end)
        return success and result or nil
    end
    
    local allServers = {}
    local cursor = nil
    local attempts = 0
    
    repeat
        local data = ListServers(cursor)
        if not data or not data.data then break end
        
        for _, server in pairs(data.data) do
            if server.id ~= game.JobId and server.playing < server.maxPlayers then
                table.insert(allServers, server)
            end
        end
        
        cursor = data.nextPageCursor
        attempts = attempts + 1
    until not cursor or attempts >= 3
    
    if #allServers > 0 then
        local randomServer = allServers[math.random(1, #allServers)]
        TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServer.id, LocalPlayer)
    end
end

local function GetPlayerNames()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(list, p.DisplayName .. " (@" .. p.Name .. ")") end
    end
    if #list == 0 then table.insert(list, "No other players") end
    return list
end

