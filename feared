        if SilentAim.TargetLockEnabled and SilentAim.TargetLocked and SilentAim.LockedTarget and SilentAim.LockedTarget.Character then
            LockedTargetHL.Adornee = SilentAim.LockedTarget.Character
            LockedTargetHL.Enabled = true
            SilentTargetHL.Enabled = false
        elseif SilentAim.ShowTarget and not SilentAim.TargetLocked then
            local target = GetClosestPlayerInFOV()
            if target and target.Character then
                SilentTargetHL.Adornee = target.Character
                SilentTargetHL.Enabled = true
                LockedTargetHL.Enabled = false
            else
                SilentTargetHL.Enabled = false
            end
        else
            SilentTargetHL.Enabled = false
            if not SilentAim.TargetLocked then
                LockedTargetHL.Enabled = false
            end
        end
    else
        SilentTargetHL.Enabled = false
        LockedTargetHL.Enabled = false
    end
end)

local previewFrameCount = 0
local cachedPreviewTarget = nil

MakeConnection(RunService.Heartbeat, function()
    if not Aimlock.Enabled then return end
    
    if Aimlock.Locked and Aimlock.Target and Aimlock.Target.Character then
        local char = Aimlock.Target.Character
        local root = char:FindFirstChild("HumanoidRootPart")
        local knocked = Aimlock.CheckKnocked and IsKnocked(char)
        
        if not knocked then
            local preferredPart = GetClosestBodyPart(char, Aimlock.Target, false, Aimlock.SelectedParts)
            
            if preferredPart and root then
                local vel = root.AssemblyLinearVelocity * Aimlock.Prediction
                CachedAimData.TargetPosition = preferredPart.Position + vel
                CachedAimData.TargetPart = preferredPart
                CachedAimData.LastUpdate = tick()
                CachedAimData.TargetVisible = true
                CachedAimData.VisiblePart = nil
                
                if Aimlock.Highlights then
                    LockedHL.Adornee = char
                    LockedHL.Enabled = true
                    PreviewHL.Enabled = false
                end
            else
                local anyVisiblePart = GetClosestBodyPart(char, Aimlock.Target, false, {
                    Head = true,
                    HumanoidRootPart = true,
                    UpperTorso = true,
                    LowerTorso = true,
                    Torso = true
                })
                
                if anyVisiblePart and root and Aimlock.PauseOnWall then
                    local vel = root.AssemblyLinearVelocity * Aimlock.Prediction
                    CachedAimData.TargetPosition = anyVisiblePart.Position + vel
                    CachedAimData.TargetPart = anyVisiblePart
                    CachedAimData.LastUpdate = tick()
                    CachedAimData.TargetVisible = true
                    CachedAimData.VisiblePart = anyVisiblePart.Name
                    
                    if Aimlock.Highlights then
                        LockedHL.Adornee = char
                        LockedHL.Enabled = true
                        PreviewHL.Enabled = false
                    end
                else
                    CachedAimData.TargetPosition = nil
                    CachedAimData.TargetVisible = false
                    CachedAimData.VisiblePart = nil
                    
                    if Aimlock.Highlights then
                        LockedHL.Adornee = char
                        LockedHL.Enabled = true
                        PreviewHL.Enabled = false
                    end
                end
            end
        end
        
        if Aimlock.Orbit and root and not knocked and LocalPlayer.Character then
            local t = tick()
            local rad = Aimlock.Radius
            local speed = Aimlock.OrbitSpeed
            local offset = Vector3.new(math.sin(t * speed) * rad, 0, math.cos(t * speed) * rad)
            LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(root.Position + offset, root.Position)
        end
    else
        LockedHL.Enabled = false
        
        previewFrameCount = previewFrameCount + 1
        if previewFrameCount % 60 == 0 then
            cachedPreviewTarget = GetTarget()
        end
        
        if cachedPreviewTarget and Aimlock.Highlights then
            PreviewHL.Adornee = cachedPreviewTarget.Character
            PreviewHL.Enabled = true
        else
            PreviewHL.Enabled = false
        end
    end
end)

MakeConnection(RunService.RenderStepped, function()
    if not Aimlock.Enabled or not Aimlock.Locked then return end
    
    if CachedAimData.TargetPosition and CachedAimData.TargetVisible then
        if Aimlock.Smoothness > 0 then
            Camera.CFrame = Camera.CFrame:Lerp(
                CFrame.new(Camera.CFrame.Position, CachedAimData.TargetPosition),
                Aimlock.Smoothness
            )
        else
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, CachedAimData.TargetPosition)
        end
    end
end)

