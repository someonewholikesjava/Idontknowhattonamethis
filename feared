    local function LoadServers()
        for _, child in pairs(ScrollFrame:GetChildren()) do
            if child:IsA("TextButton") then
                pcall(function() child:Destroy() end)
            end
        end
        
        LoadingLabel.Visible = true
        LoadingLabel.Text = "Loading servers..."
        
        local Api = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
        
        local function FetchServers(cursor)
            local success, result = pcall(function()
                local url = Api .. ((cursor and "&cursor=" .. cursor) or "")
                local response = game:HttpGet(url)
                return HttpService:JSONDecode(response)
            end)
            return success and result or nil
        end
        
        local allServers = {}
        local cursor = nil
        local pageCount = 0
        
        repeat
            local data = FetchServers(cursor)
            if not data or not data.data then break end
            
            for _, server in pairs(data.data) do
                if server.id ~= game.JobId and server.playing < server.maxPlayers then
                    table.insert(allServers, {
                        id = server.id,
                        playing = server.playing,
                        maxPlayers = server.maxPlayers,
                        ping = server.ping or 999
                    })
                end
            end
            
            cursor = data.nextPageCursor
            pageCount = pageCount + 1
        until not cursor or pageCount >= 5
        
        table.sort(allServers, function(a, b)
            return a.ping < b.ping
        end)
        
        LoadingLabel.Visible = false
        
        if #allServers == 0 then
            LoadingLabel.Visible = true
            LoadingLabel.Text = "No servers found!"
        else
            for index, server in pairs(allServers) do
                CreateServerEntry(server, index)
            end
            
            ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, #allServers * 37)
            
            Notify("Loaded " .. #allServers .. " servers!")
        end
    end

