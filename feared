-- [[ AUTO PREDICTION ]] --
local CurrentPing = 0
local LastPingUpdate = 0
local PingDisplayLabel = nil

local function CalculatePrediction(pingMs)
    local basePrediction = 0.110
    local predictionPerMs = 0.0005
    local calculated = basePrediction + (pingMs * predictionPerMs)
    return math.floor(calculated * 1000 + 0.5) / 1000
end

local function UpdateAutoPrediction()
    local now = tick()
    if now - LastPingUpdate < 0.5 then return end
    LastPingUpdate = now
    
    local success, ping = pcall(function()
        return LocalPlayer:GetNetworkPing() * 1000
    end)
    
    if success and ping then
        CurrentPing = math.floor(ping + 0.5)
        local newPrediction = CalculatePrediction(CurrentPing)
        
        if Aimlock.AutoPrediction then
            Aimlock.Prediction = newPrediction
            if Options and Options.Pred then
                pcall(function()
                    Options.Pred:SetValue(string.format("%.3f", newPrediction))
                end)
            end
        end
        
        if SilentAim.AutoPrediction then
            SilentAim.Prediction = newPrediction
            if Options and Options.SilentPred then
                pcall(function()
                    Options.SilentPred:SetValue(string.format("%.3f", newPrediction))
                end)
            end
        end
    end
end

