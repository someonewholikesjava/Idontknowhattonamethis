local KnockCache = {}
local KnockCacheTime = {}

local function IsKnocked(char)
    if not char then return true end
    
    local now = tick()
    if KnockCacheTime[char] and (now - KnockCacheTime[char]) < 2 then
        return KnockCache[char]
    end
    
    local hum = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then 
        KnockCache[char] = true
        KnockCacheTime[char] = now
        return true 
    end
    
    if hum.PlatformStand or (hum.Sit and not hum.SeatPart) then 
        KnockCache[char] = true
        KnockCacheTime[char] = now
        return true 
    end
    
    if char:FindFirstChild("GRABBING_CONSTRAINT") then 
        KnockCache[char] = true
        KnockCacheTime[char] = now
        return true 
    end
    
    local folder = char:FindFirstChild("BodyEffects") or char:FindFirstChild("BodyValues") or char:FindFirstChild("Status")
    if folder then
        local ko = folder:FindFirstChild("K.O") or folder:FindFirstChild("KO") or folder:FindFirstChild("Knocked")
        if ko and ((ko:IsA("BoolValue") and ko.Value) or (ko:IsA("NumberValue") and ko.Value > 0)) then 
            KnockCache[char] = true
            KnockCacheTime[char] = now
            return true 
        end
    end
    
    KnockCache[char] = false
    KnockCacheTime[char] = now
    return false
end

local VisibilityCache = {}
local VisibilityCacheTime = {}

local function IsVisible(targetPlayer, part)
    if not targetPlayer or not targetPlayer.Character or not part then return false end
    
    local now = tick()
    local cacheKey = targetPlayer.UserId .. "_" .. part.Name
    
    if VisibilityCacheTime[cacheKey] and (now - VisibilityCacheTime[cacheKey]) < 0.1 then
        return VisibilityCache[cacheKey]
    end
    
    local origin = Camera.CFrame.Position
    local dir = part.Position - origin
    
    local ignoreList = {LocalPlayer.Character, Camera, Workspace:FindFirstChild("Ignored"), Workspace:FindFirstChild("Barrier")}
    
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = ignoreList
    rayParams.IgnoreWater = true
    
    local result = Workspace:Raycast(origin, dir, rayParams)
    local isVisible = not result or result.Instance:IsDescendantOf(targetPlayer.Character)
    
    VisibilityCache[cacheKey] = isVisible
    VisibilityCacheTime[cacheKey] = now
    
    return isVisible
end

local function GetClosestBodyPart(char, player, ignoreVisibility, partsTable)
    local closestPart = nil
    local minDist = 99999
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
    
    local partsToCheck = partsTable or { ["Head"] = true }
    if next(partsToCheck) == nil then partsToCheck = { ["Head"] = true } end

    for partName, isEnabled in pairs(partsToCheck) do
        if isEnabled then
            local part = char:FindFirstChild(partName)
            if part then
                if ignoreVisibility or IsVisible(player, part) then
                    local pos, onScreen = Camera:WorldToScreenPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                        if dist < minDist then
                            minDist = dist
                            closestPart = part
                        end
                    end
                end
            end
        end
    end
    
    if not closestPart and not ignoreVisibility then
        local allParts = {"Head", "HumanoidRootPart", "UpperTorso", "LowerTorso", "Torso"}
        for _, partName in pairs(allParts) do
            local part = char:FindFirstChild(partName)
            if part and IsVisible(player, part) then
                local pos, onScreen = Camera:WorldToScreenPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < minDist then
                        minDist = dist
                        closestPart = part
                    end
                end
            end
        end
    end
    
    return closestPart
end

local function GetTarget()
    local closest = nil
    local minDist = 99999
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if not (Aimlock.CheckKnocked and IsKnocked(p.Character)) then
                local bestPart = GetClosestBodyPart(p.Character, p, false, Aimlock.SelectedParts)
                if bestPart then
                    local hum = p.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local pos = Camera:WorldToScreenPoint(bestPart.Position)
                        local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                        if dist < minDist then
                            closest = p
                            minDist = dist
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- [[ SILENT AIM FUNCTIONS ]] --

local function CalculateHitChance(chance)
    return math.random(1, 100) <= chance
end

local LastTargetCheck = 0
local CachedSilentTarget = nil

local function GetClosestPlayerInFOV()
    local now = tick()
    if now - LastTargetCheck < 0.05 and CachedSilentTarget and CachedSilentTarget.Character then
        return CachedSilentTarget
    end
    
    LastTargetCheck = now
    
    if SilentAim.TargetLockEnabled and SilentAim.TargetLocked and SilentAim.LockedTarget then
        local lockedPlayer = SilentAim.LockedTarget
        if lockedPlayer.Character then
            if not (SilentAim.CheckKnocked and IsKnocked(lockedPlayer.Character)) then
                local bestPart = GetClosestBodyPart(lockedPlayer.Character, lockedPlayer, not SilentAim.VisibleCheck, SilentAim.SelectedParts)
                if bestPart then
                    local hum = lockedPlayer.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local pos, onScreen = Camera:WorldToScreenPoint(bestPart.Position)
                        if onScreen then
                            local mousePos = Vector2.new(Mouse.X, Mouse.Y)
                            local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                            
                            if dist <= SilentAim.FOVRadius then
                                CachedSilentTarget = lockedPlayer
                                return lockedPlayer
                            end
                        end
                    end
                end
            end
        end
        CachedSilentTarget = nil
        return nil
    end
    
    local closest = nil
    local minDist = math.huge
    local mousePos = Vector2.new(Mouse.X, Mouse.Y)
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if not (SilentAim.CheckKnocked and IsKnocked(p.Character)) then
                local bestPart = GetClosestBodyPart(p.Character, p, not SilentAim.VisibleCheck, SilentAim.SelectedParts)
                if bestPart then
                    local hum = p.Character:FindFirstChild("Humanoid")
                    if hum and hum.Health > 0 then
                        local pos, onScreen = Camera:WorldToScreenPoint(bestPart.Position)
                        if onScreen then
                            local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                            
                            if SilentAim.OnlyInFOV then
                                if dist <= SilentAim.FOVRadius and dist < minDist then
                                    closest = p
                                    minDist = dist
                                end
                            elseif dist < minDist then
                                closest = p
                                minDist = dist
                            end
                        end
                    end
                end
            end
        end
    end
    
    CachedSilentTarget = closest
    return closest
end

local function GetPredictedPosition(targetPart, prediction)
    if not targetPart or not targetPart.Parent then return nil end
    
    local char = targetPart.Parent
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    
    if not root or not hum then return targetPart.Position end
    
    local velocity = root.AssemblyLinearVelocity
    
    if SilentAim.UseJumpOffset and hum.FloorMaterial == Enum.Material.Air then
        velocity = velocity + Vector3.new(0, SilentAim.JumpOffset, 0)
    end
    
    if SilentAim.AntiCurve then
        velocity = velocity:Lerp(Vector3.new(velocity.X, velocity.Y * 0.94, velocity.Z), 0.4)
    end
    
    local predictedPos = targetPart.Position + (velocity * prediction)
    
    return predictedPos
end

